# CORS
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19000"

# Email (SendGrid/SMTP)
SENDGRID_API_KEY=""

# OpenAI
OPENAI_API_KEY=""

# Storage (S3/Cloudflare R2)
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
