# ===========================================
# PrimeCell API - Production Environment
# ===========================================
# Copy this file to .env on your VPS and fill in the values

# Server
PORT=1997
NODE_ENV=production

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://primecell_user:YOUR_SECURE_PASSWORD@localhost:5432/primecell_db?schema=public"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
# IMPORTANT: Generate a secure random string for production!
# You can use: openssl rand -base64 64
JWT_SECRET="GENERATE_A_SECURE_64_CHARACTER_SECRET_HERE"
JWT_EXPIRATION="7d"

# CORS - Add your domain here
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS="https://yourdomain.com"

# Email (SendGrid)
# Get your API key from https://sendgrid.com/
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="PrimeCell"

# OpenAI (for AI-powered features)
OPENAI_API_KEY="your-openai-api-key"

# Storage (AWS S3 - optional)
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
